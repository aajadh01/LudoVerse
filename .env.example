# Server Port
PORT=3001

# Production Environment
NODE_ENV=production

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/ludoverse?retryWrites=true&w=majority

# CORS Allowed Origin (set to '*' or your frontend URL)
CLIENT_ORIGIN=*

# LiveKit Realtime Media Configuration (cloud.livekit.io)
# Server-only credentials for NAT/firewall traversal SFU media delivery
LIVEKIT_URL=wss://<project-subdomain>.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=secretxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
